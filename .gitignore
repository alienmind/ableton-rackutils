node_modules/
dist/
dist-relative/
*.tsbuildinfo
.DS_Store

# Scratch work: spikes, one-off scripts, files read once. Never commit here.
tmp/

# Real racks stay local. They are personal project data and can be large.
# Covers stray output from `pnpm adg-inspect move ...` too, wherever it lands.
*.adg

# Donors are the exception: device instances the contract copies from, which
# have to ship with the code (PLAN.md Constraint 7).
!packages/adg-codec/donors/*.adg
playwright-report/
test-results/
