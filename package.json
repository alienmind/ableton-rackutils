{
  "name": "ableton-rackutils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @rackutils/site dev",
    "dev:device": "pnpm --filter @rackutils/m4l-device dev",
    "build": "pnpm --filter @rackutils/site build",
    "build:device": "pnpm --filter @rackutils/m4l-device build",
    "install:device": "pnpm build:device && pnpm --filter @rackutils/m4l-device install:device",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p packages/adg-codec && tsc --noEmit -p packages/editor-ui && tsc --noEmit -p apps/site && tsc --noEmit -p apps/site/tsconfig.e2e.json && tsc --noEmit -p tools/adg-tool && pnpm --filter @rackutils/m4l-device exec tsc -b",
    "test": "pnpm -r test",
    "adg-tool": "tsx tools/adg-tool/src/index.ts",
    "test:e2e": "pnpm --filter @rackutils/site test:e2e",
    "adg-palette": "tsx tools/adg-tool/src/palette.ts",
    "adg-harvest": "tsx tools/adg-tool/src/harvest.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
